{
  // Cloudflare settings for Hot Seat Poker. You shouldn't need to change anything here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hot-seat-poker",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "Directory"] }
  ],
  "observability": { "enabled": true }
}
